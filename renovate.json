{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "rangeStrategy": "update-lockfile",
  "ignoreDeps": [
    "camelcase",
    "mysql",
    "swagger-ui-react",
    "leven",
    "ora",
    "graphiql"
  ],
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Keep in sync with minimumReleaseAge in pnpm-workspace.yaml, otherwise pnpm refuses to update the lockfile",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "timezone": "Europe/Rome",
  "schedule": ["* 0-6 * * 6,0"],
  "rebaseWhen": "conflicted"
}
